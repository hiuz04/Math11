VITE_USE_MOCK_API=false
# Local development uses Vite's proxy; production uses the rewrite in vercel.json.
# Set VITE_API_URL=/api on Vercel as well (redeploy after changing it).
VITE_API_URL=/api
# Legacy VITE_API_BASE_URL is supported when VITE_API_URL is not set.
BACKEND_URL=http://localhost:8080
BACKEND_CONTEXT=/Math11

# Local development profile: copy to .env.dev (ignored by Git).
APP_ENV=development
APP_ORIGIN=http://localhost:8443
# Use an existing local SQL Server database with the V002 schema.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=math11_tutor_db;encrypt=true;trustServerCertificate=true
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5
DB_QUERY_TIMEOUT_SECONDS=30
# Relative to this file; separate from the default profile's uploads.
STORAGE_DIR=./private-storage/dev
SESSION_TIMEOUT_MINUTES=30
# Optional for AI. Base64-encoded 32 random bytes to save API keys in SQL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_ENCRYPTION_KEY=
RUN_SQL_INTEGRATION=false
RUN_GEMINI_INTEGRATION=false
RUN_WAR_DEPLOYMENT=false

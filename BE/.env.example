APP_ENV=development
# Required full JDBC URL, e.g. jdbc:sqlserver://<host>:1433;databaseName=<database>;encrypt=true;trustServerCertificate=false
DB_URL=
DB_USER=
DB_PASSWORD=
# Legacy DB_USERNAME is supported when DB_USER is not set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Base64-encoded 32 random bytes; required to save an API key in SQL Server.
APP_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:8443
STORAGE_DIR=./private-storage
SESSION_TIMEOUT_MINUTES=30

# Pool and JDBC statement timeout.
DB_POOL_SIZE=10
DB_QUERY_TIMEOUT_SECONDS=30
# Explicit opt-in only; SQL tests refuse any database not ending in _test.
RUN_SQL_INTEGRATION=false
RUN_GEMINI_INTEGRATION=false
RUN_WAR_DEPLOYMENT=false
